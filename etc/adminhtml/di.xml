<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--Security-->
    <type name="\Magento\Backend\Controller\Adminhtml\Auth\Login">
        <plugin name="mp_security_login" type="Mageplaza\Security\Plugin\Login"/>
    </type>
    <type name="\Magento\User\Model\ResourceModel\User">
        <plugin name="mp_security_lock_user" type="Mageplaza\Security\Plugin\LockUser"/>
    </type>
    <type name="Magento\Ui\Model\Export\MetadataProvider">
        <arguments>
            <argument name="data" xsi:type="array">
                <item name="mageplaza_security_loginlog_listing" xsi:type="array">
                    <item name="created_at" xsi:type="string">time</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!--Two Factor Auth-->
    <type name="Magento\Backend\Block\System\Account\Edit\Form">
        <plugin name="mp-twofactorauth-user-edit" type="Mageplaza\Security\Plugin\Adminhtml\Block\System\Account\Edit\Form" sortOrder="20"/>
    </type>
    <preference for="Magento\Backend\Controller\Adminhtml\System\Account\Save" type="Mageplaza\Security\Controller\Adminhtml\System\Account\Save"/>
    <preference for="Magento\Backend\Model\Auth" type="Mageplaza\Security\Model\Auth"/>
    <preference for="Magento\Backend\App\Action\Plugin\Authentication" type="Mageplaza\Security\App\Action\Plugin\Authentication"/>
</config>