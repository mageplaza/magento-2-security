<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <security>
            <module>
                <user_guide>magento/security</user_guide>
                <type>1</type>
            </module>
            <general>
                <enabled>1</enabled>
            </general>
            <brute_force>
                <enabled>1</enabled>
                <failed_count>5</failed_count>
                <failed_time>10</failed_time>
                <lock_user>1</lock_user>
                <email_template>security_brute_force_email_template</email_template>
            </brute_force>
            <mptwofactorauth>
                <general>
                    <enabled>0</enabled>
                    <force_2fa>0</force_2fa>
                    <trust_device>0</trust_device>
                    <trust_time>30</trust_time>
                    <whitelist_ip></whitelist_ip>
                </general>
            </mptwofactorauth>
            <googlerecaptcha>
                <backend>
                    <enabled>0</enabled>
                    <size>normal</size>
                    <theme>light</theme>
                </backend>
                <frontend>
                    <enabled>0</enabled>
                    <type>invisible</type>
                    <forms>body.customer-account-create #form-validate.form-create-account</forms>
                    <position>bottomleft</position>
                    <theme>light</theme>
                </frontend>
            </googlerecaptcha>
        </security>
    </default>
</config>
